# Copy this file to .env and adjust the values. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=4000

# Local MongoDB from docker-compose (start it with: npm run db:up).
# 127.0.0.1 rather than "localhost": Node may resolve localhost to IPv6 (::1),
# but the container only listens on IPv4.
MONGODB_URI=mongodb://127.0.0.1:27017/taskboard

# The frontend origin allowed by CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens (JWT). At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars

# Email (password reset links) via Resend: https://resend.com
# Leave RESEND_API_KEY empty in development: emails are then printed in the terminal instead of sent.
RESEND_API_KEY=
# Without your own verified domain, Resend only allows this sender and only delivers to your account's email
MAIL_FROM=Task Board <onboarding@resend.dev>
