# Copy this file to .env and adjust the values. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=4000

# Local MongoDB from docker-compose (start it with: npm run db:up).
# 127.0.0.1 rather than "localhost": Node may resolve localhost to IPv6 (::1),
# but the container only listens on IPv4.
MONGODB_URI=mongodb://127.0.0.1:27017/taskboard

# The frontend's origin. Used for CORS AND for the links in emails/invites (password reset,
# board invites). In production set this to the deployed frontend URL, e.g. https://tasklane.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens (JWT). At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars

# Email (password reset links) via SendGrid: https://sendgrid.com
# Leave SENDGRID_API_KEY empty in development: emails are then printed in the terminal instead of sent.
SENDGRID_API_KEY=
# MUST exactly match a sender you verified in SendGrid (Settings -> Sender Authentication ->
# Single Sender). Use your own email, e.g. Tasklane <you@gmail.com>
MAIL_FROM=Tasklane <your-verified-sender@example.com>

# Profile pictures are uploaded to Cloudinary (https://cloudinary.com, free tier is enough):
# Dashboard -> API Keys. All three are optional: without them the app runs, but avatar upload
# answers 503 AVATAR_UNAVAILABLE.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
